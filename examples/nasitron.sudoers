# Example /etc/sudoers.d/nasitron
#
# Verify command paths on the monitored Ubuntu host with:
#   command -v smartctl
#   command -v dmesg
#   command -v zpool
#
# smartctl is needed for drive/NVMe health collection.
# dmesg is only used by the on-demand tuning/support bundle.
# zpool replace is only needed if you enable/use the failed-drive replacement page.
#
# IMPORTANT: "zpool replace" is a mutating administrative operation. Grant this
# capability only to a dedicated NASitron SSH account and protect the dashboard.
#
# Adjust paths to match the target host before installing this file.
nasitron ALL=(root) NOPASSWD: /usr/sbin/smartctl -a -j *, /usr/bin/smartctl -a -j *, /usr/bin/dmesg, /bin/dmesg, /usr/sbin/zpool replace *, /usr/bin/zpool replace *
