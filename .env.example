# Required.
# Generate with: openssl rand -hex 32
NASITRON_SECRET_KEY=replace-with-at-least-32-random-characters
# Credentials for the NASitron web sign-in form.
NASITRON_WEB_USERNAME=admin
NASITRON_WEB_PASSWORD=replace-with-a-long-unique-password

NASITRON_TIMEZONE=America/New_York

# Default hostname/IP shown in TLS settings and used when configuring ACME.
# Internal/bootstrap TLS is host-agnostic and will issue a local certificate
# on demand for the IP or hostname you actually browse to.
NASITRON_TLS_HOST=localhost

# Docker host address and ports exposed by the Caddy front end.
# Examples:
#   NASITRON_LISTEN_IP=0.0.0.0   # all IPv4 interfaces
#   NASITRON_LISTEN_IP=127.0.0.1 # loopback only
NASITRON_LISTEN_IP=0.0.0.0
NASITRON_HTTP_PORT=80
NASITRON_HTTPS_PORT=443

# Signed login-session lifetime. Default: 12 hours.
NASITRON_SESSION_TTL_SECONDS=43200

# Docker Compose includes Caddy and exposes only ports 80/443; NASitron itself
# remains private on the Compose network. Set true only for direct local
# development without Caddy.
NASITRON_ALLOW_INSECURE_HTTP=false

# Maintenance remains separately protected even if general HTTP is allowed.
NASITRON_ALLOW_INSECURE_MAINTENANCE=false

# When running outside the supplied Compose stack, set Uvicorn's
# FORWARDED_ALLOW_IPS only to the address/network of your trusted proxy.
# Compose uses "*" safely because application port 8080 is not published.

NASITRON_COLLECTOR_WORKERS=2
NASITRON_MAX_METRIC_POINTS=1200
NASITRON_MAX_REQUEST_BODY_BYTES=262144
NASITRON_MAX_REMOTE_OUTPUT_BYTES=8388608
NASITRON_MAX_DIAGNOSTIC_OUTPUT_BYTES=4194304
NASITRON_REMOTE_HELPER_PATH=/usr/local/sbin/nasitron-root-helper
