# Required.
# Generate with: openssl rand -hex 32
NASITRON_SECRET_KEY=replace-with-at-least-32-random-characters
NASITRON_WEB_USERNAME=admin
NASITRON_WEB_PASSWORD=replace-with-a-long-unique-password

NASITRON_TIMEZONE=America/New_York

# NASitron requires HTTPS for the web UI by default. With a reverse proxy,
# leave this false and trust only that proxy with NASITRON_FORWARDED_ALLOW_IPS.
# Set true only on an intentionally trusted private management network.
NASITRON_ALLOW_INSECURE_HTTP=false

# Maintenance remains separately protected even if general HTTP is allowed.
NASITRON_ALLOW_INSECURE_MAINTENANCE=false

# Set to the reverse proxy container/host IP or trusted network. Never use "*"
# when untrusted clients can reach NASitron directly.
NASITRON_FORWARDED_ALLOW_IPS=127.0.0.1

NASITRON_COLLECTOR_WORKERS=2
NASITRON_MAX_METRIC_POINTS=1200
NASITRON_MAX_REQUEST_BODY_BYTES=262144
NASITRON_MAX_REMOTE_OUTPUT_BYTES=8388608
NASITRON_MAX_DIAGNOSTIC_OUTPUT_BYTES=4194304
NASITRON_REMOTE_HELPER_PATH=/usr/local/sbin/nasitron-root-helper
